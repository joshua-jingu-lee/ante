# Shared collaboration context

# Local agent overrides
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/

# Repo-local GitHub CLI auth (tokens)
.github/local/*
!.github/local/*.example

# Agent 참고 자료 (임시 작업 디렉토리만 제외)
docs/temp/
docs/superpowers/

# Runtime data (루트 디렉토리만 — src/ante/data/ 는 소스코드)
/data/
/db/
/logs/

# Secrets
config/secrets.env
config/secrets.env.bak.*
config/system.toml
.env
.env.*
!.env.example
*.pem
*.key

# 작업 디렉터리의 config/db에 남는 런타임 산출물 (ante update의 의존성 스냅숏, 격리 이전 테스트가 만든 DB. #2592)
config/db/

